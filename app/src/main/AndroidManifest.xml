<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="AccessHub SA"
        android:supportsRtl="true"
        android:theme="@style/Theme.AccessHubSA"
        android:usesCleartextTraffic="true">

        <activity android:name=".ui.settings.SettingsActivity" />
        <activity android:name=".ui.requests.MyRequestsActivity" />
        <activity android:name=".ui.request.RequestActivity" />
        <activity android:name=".ui.services.ServicesActivity" />
        <activity android:name=".ui.home.HomeActivity" />
        <activity android:name=".ui.register.RegisterActivity" />
        <activity android:name=".ui.login.LoginActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
